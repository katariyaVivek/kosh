# Master key for encrypting API keys (min 12 chars, 64+ recommended)
# Generate one with: openssl rand -hex 32
KOSH_MASTER_KEY=your-random-64-char-key-here

# SQLite database path (local mode)
# Docker uses: file:/app/data/kosh.db
DATABASE_URL=file:./kosh.db

# Provider OAuth client credentials (optional — only needed for the
# corresponding provider's CLI/IDE sign-in flows). Kosh ships without any
# embedded provider credentials; set these to enable those flows.
# GEMINI_OAUTH_CLIENT_ID=
# GEMINI_OAUTH_CLIENT_SECRET=
# ANTIGRAVITY_OAUTH_CLIENT_ID=
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=
# IFLOW_OAUTH_CLIENT_ID=
# IFLOW_OAUTH_CLIENT_SECRET=
# WINDSURF_OAUTH_CLIENT_ID=
# WINDSURF_FIREBASE_API_KEY=
